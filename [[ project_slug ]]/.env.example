POSTGRES_DB=[[ postgres_db ]]
POSTGRES_USER=[[ postgres_user ]]
POSTGRES_PASSWORD=[[ postgres_password ]]

APP_PORT=[[ frontend_port ]]
PUBLIC_BASE_URL=[[ public_base_url ]]
AUTH_MODE=[[ auth_mode ]]

[% if auth_mode == "bundled" %]
KEYCLOAK_ADMIN_USERNAME=[[ keycloak_admin_username ]]
KEYCLOAK_ADMIN_PASSWORD=[[ keycloak_admin_password ]]
KEYCLOAK_REALM=[[ keycloak_realm ]]
KEYCLOAK_HOSTNAME=[[ public_base_url ]]/auth
[% else %]
EXTERNAL_AUTH_ISSUER_URI=[[ external_auth_issuer_uri ]]
[% endif %]

SPRING_APPLICATION_NAME=[[ backend_artifact_id ]]
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/[[ postgres_db ]]
SPRING_DATASOURCE_USERNAME=[[ postgres_user ]]
SPRING_DATASOURCE_PASSWORD=[[ postgres_password ]]
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_OPEN_IN_VIEW=false
[% if auth_mode == "bundled" %]
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=[[ public_base_url ]]/auth/realms/[[ keycloak_realm ]]
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/auth/realms/[[ keycloak_realm ]]/protocol/openid-connect/certs
[% else %]
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=[[ external_auth_issuer_uri ]]
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=[[ external_auth_issuer_uri ]]/protocol/openid-connect/certs
[% endif %]
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
