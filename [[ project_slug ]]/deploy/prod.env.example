COMPOSE_PROJECT_NAME=[[ project_slug ]]
BACKEND_IMAGE=ghcr.io/OWNER/REPOSITORY-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/OWNER/REPOSITORY-frontend:COMMIT_SHA
PUBLIC_BASE_URL=https://[[ project_slug ]].example.com
POSTGRES_DB=[[ postgres_db ]]
POSTGRES_USER=[[ postgres_user ]]
POSTGRES_PASSWORD=CHANGE_ME
[% if auth_mode == "bundled" %]
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_HTTP_PORT=18081
[% else %]
EXTERNAL_AUTH_ISSUER_URI=[[ external_auth_issuer_uri ]]
[% endif %]
BACKEND_HTTP_PORT=18080
