{
  "/api": {
    "target": "http://127.0.0.1:8080",
    "secure": false
  },
  "/api/**": {
    "target": "http://127.0.0.1:8080",
    "secure": false
  },
  "/actuator": {
    "target": "http://127.0.0.1:8080",
    "secure": false
  },
  "/actuator/**": {
    "target": "http://127.0.0.1:8080",
    "secure": false
  }
[% if auth_mode == "bundled" %],
  "/auth": {"target": "http://127.0.0.1:8081", "secure": false, "xfwd": true},
  "/auth/**": {"target": "http://127.0.0.1:8081", "secure": false, "xfwd": true}
[% endif %]
}
